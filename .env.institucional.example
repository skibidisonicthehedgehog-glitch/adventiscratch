# Copie para .env.institucional e mantenha o arquivo fora do Git.
# Use valores aleatórios distintos para as três senhas/chaves.
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
ADVENTISCRATCH_REDIS_PASSWORD=

# Apenas o hostname, sem https:// ou caminho.
ADVENTISCRATCH_DOMINIO=
# Token do túnel gerenciado no Cloudflare.
CLOUDFLARE_TUNNEL_TOKEN=

POSTGRES_DB=adventiscratch
POSTGRES_USER=adventiscratch
ADVENTISCRATCH_MULTIPLAYER=1
