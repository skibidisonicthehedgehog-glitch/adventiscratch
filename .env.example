# Copie para ".env" e preencha. NUNCA envie o .env para o GitHub.

# ---- Obrigatório ----
# Gere uma chave com:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Endereços pelos quais o site será acessado (separados por vírgula)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Para o painel de moderação funcionar em HTTPS (Cloudflare), coloque o endereço completo:
DJANGO_CSRF_TRUSTED_ORIGINS=

# Primeiro moderador (criado ao iniciar; pode apagar estas linhas depois)
ADVENTISCRATCH_MODERADOR=diretor
ADVENTISCRATCH_MODERADOR_SENHA=troque-esta-senha

# ---- Rede ----
# Porta no computador/servidor e em qual endereço ela escuta
PORTA=8000
ENDERECO=0.0.0.0

# ---- Cloudflare Tunnel (opcional) ----
# 1) dash.cloudflare.com -> Zero Trust -> Networks -> Tunnels -> Create a tunnel (Cloudflared)
# 2) Copie o token do comando de instalação e cole abaixo
# 3) Public Hostname: seu domínio  ->  Service: HTTP  ->  URL: adventiscratch:8000
# 4) Ajuste DJANGO_ALLOWED_HOSTS e DJANGO_CSRF_TRUSTED_ORIGINS com o domínio e use ENDERECO=127.0.0.1
CLOUDFLARE_TUNNEL_TOKEN=
ADVENTISCRATCH_ATRAS_DE_PROXY=0

# ---- PostgreSQL (opcional; sem isto usa SQLite, que já basta para uma escola) ----
# POSTGRES_DB=adventiscratch
# POSTGRES_USER=adventiscratch
# POSTGRES_PASSWORD=troque-esta-senha
# POSTGRES_HOST=db

# ---- Ajustes ----
TZ=America/Sao_Paulo
ADVENTISCRATCH_TOKEN_DIAS=30

# ---- Servidor Multiplayer (só para quem tem conta) ----
ADVENTISCRATCH_MULTIPLAYER=1
ADVENTISCRATCH_MULTI_MAX_JOGADORES=20
ADVENTISCRATCH_MULTI_MAX_SALAS=200
ADVENTISCRATCH_MULTI_MSG_SEG=60

# ---- Nuvem e loja de modelos ----
ADVENTISCRATCH_MAX_PROJETO_MB=50
ADVENTISCRATCH_MAX_MODELO_MB=40
ADVENTISCRATCH_MAX_PROJETOS=100
ADVENTISCRATCH_ENVIOS_POR_HORA=60
# true = modelos novos da loja só aparecem depois que um moderador aprova
ADVENTISCRATCH_APROVAR_MODELOS=false
# Tamanho máximo de um SoundFont (.sf2) na Loja de Instrumentos Virtuais, em MB
ADVENTISCRATCH_MAX_SF2_MB=50
